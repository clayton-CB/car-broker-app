{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src"],
  // The pre-OC-Pro tree (src/pages, src/components, src/hooks, src/App.tsx, src/lib,
  // src/types) is an unreferenced earlier iteration that imports packages this project
  // never installed (react-router-dom, @tanstack/react-query, @supabase/supabase-js).
  // Kept on disk, excluded from typechecking. The live app is src/app + src/main.tsx.
  "exclude": [
    "src/App.tsx",
    "src/pages",
    "src/components",
    "src/hooks",
    "src/lib",
    "src/types"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
